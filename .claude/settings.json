{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/mise exec -- $HOME/.local/bin/hookah hook claude",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/mise exec -- $HOME/.local/bin/hookah hook claude",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
